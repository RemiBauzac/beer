{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm audit *)",
      "Bash(bd stats *)",
      "Bash(bd list *)",
      "Bash(bd remember *)",
      "Bash(bd create *)",
      "Bash(bd init *)",
      "Bash(bd dep *)",
      "Bash(bd close *)",
      "Bash(bd ready *)",
      "Bash(bd show *)",
      "Bash(bd update *)",
      "Bash(npm install *)",
      "Bash(bd dolt *)",
      "Bash(npx husky *)",
      "Bash(git add *)",
      "Bash(npx eslint *)",
      "Bash(git commit -m ' *)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  }
}
