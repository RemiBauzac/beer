{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm audit *)",
      "Bash(bd stats *)",
      "Bash(bd list *)",
      "Bash(bd remember *)",
      "Bash(bd create *)",
      "Bash(bd init *)",
      "Bash(bd dep *)",
      "Bash(bd close *)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  }
}
